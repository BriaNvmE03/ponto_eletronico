generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id             String   @id @default(uuid())
  name           String   @unique
  price          Float
  maxUsers       Int
  maxDepartments Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenants        Tenant[]

  @@map("plans")
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  status        TenantStatus    @default(ATIVO)
  planId        String?
  departments   Department[]
  settings      TenantSettings?
  plan          Plan?           @relation(fields: [planId], references: [id])
  users         User[]
  workSchedules WorkSchedule[]

  @@map("tenants")
}

model TenantSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  requirePhoto        Boolean  @default(false)
  requireLocation     Boolean  @default(false)
  allowedLat          Float?
  allowedLng          Float?
  allowedRadius       Int?
  allowFridayAnywhere Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Department {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  createdAt     DateTime            @default(now())
  settings      DepartmentSettings?
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  workSchedules WorkSchedule[]

  @@map("departments")
}

model DepartmentSettings {
  id                  String     @id @default(uuid())
  departmentId        String     @unique
  requirePhoto        Boolean?
  requireLocation     Boolean?
  allowedLat          Float?
  allowedLng          Float?
  allowedRadius       Int?
  allowFridayAnywhere Boolean?
  updatedAt           DateTime   @updatedAt
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_settings")
}

model WorkSchedule {
  id                   String      @id @default(uuid())
  tenantId             String
  departmentId         String?
  dayOfWeek            Int
  expectedStart1       String?
  expectedEnd1         String?
  expectedStart2       String?
  expectedEnd2         String?
  totalExpectedMinutes Int         @default(0)
  isExtraShift         Boolean     @default(false)
  createdAt            DateTime    @default(now())
  department           Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("work_schedules")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  fullName       String
  role           Role            @default(EMPLOYEE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String?
  avatarUrl      String?
  departmentId   String?
  isActive       Boolean         @default(true)
  isFirstLogin   Boolean         @default(true)
  phone          String?
  dailyRecords   DailyRecord[]
  justifications Justification[]
  punches        Punch[]
  department     Department?     @relation(fields: [departmentId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model DailyRecord {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime
  expectedMinutes Int      @default(0)
  workedMinutes   Int      @default(0)
  balanceMinutes  Int      @default(0)
  isExtraShiftDay Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  punches         Punch[]

  @@map("daily_records")
}

model Punch {
  id              String          @id @default(uuid())
  dailyRecordId   String
  userId          String
  type            RecordType
  timestamp       DateTime        @default(now())
  photoUrl        String?
  locationLat     Float?
  locationLng     Float?
  deviceInfo      String?
  isEditedByAdmin Boolean         @default(false)
  createdAt       DateTime        @default(now())
  justifications  Justification[]
  dailyRecord     DailyRecord     @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("punches")
}

model Justification {
  id            String              @id @default(uuid())
  userId        String
  punchId       String?
  reason        String
  status        JustificationStatus @default(PENDING)
  attachmentUrl String?
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?
  punch         Punch?              @relation(fields: [punchId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("justifications")
}

enum Role {
  SUPERADMIN
  ADMIN
  EMPLOYEE
}

enum RecordType {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  ATIVO
  PENDENTE
  DESATIVADO
  CANCELADO
}
